#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
/ {
    keymap {
        compatible = "zmk,keymap";
        base {
            bindings = <
                &mo 2     &kp Q &kp W &kp E &kp R &kp T  &kp Y &kp U &kp I     &kp O   &kp P   &kp BSPC
                &mo 1     &kp A &kp S &kp D &kp F &kp G  &kp H &kp J &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B  &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp LCTRL &kp LALT &kp LGUI &kp LSHFT &kp SPACE  &kp RGUI &mo 1 &kp SPACE &mo 2 &mo 3
            >;
        };
        symbols {
            bindings = <
                &trans &kp EXCL &kp AT &kp LPAR &kp RPAR &kp LBKT &kp RBKT &kp GT &kp UP &kp EQUAL &kp PLUS &kp DEL
                &trans &kp AMPS &kp ASTRK &kp DLLR &kp PRCNT &kp LBRC &kp RBRC &kp LEFT &kp DOWN &kp RIGHT &kp MINUS &kp ENTER
                &trans &kp GRAVE &kp F24 &kp CARET &kp HASH &none &none &kp LS(TAB) &kp GRAVE &kp TAB &kp BSLH &trans
                &trans &trans &trans &trans &trans &trans &trans &kp ESC &trans &trans
            >;
        };
        numbers {
            bindings = <
                &trans &kp EXCL &kp AT &kp LPAR &kp RPAR &kp LBKT &kp RBKT &kp N7 &kp N8 &kp N9 &kp PLUS &kp BSPC
                &trans &kp AMPS &kp ASTRK &kp DLLR &kp PRCNT &kp LBRC &kp RBRC &kp N4 &kp N5 &kp N6 &kp MINUS &kp ENTER
                &trans &kp GRAVE &kp F24 &kp CARET &kp HASH &none &kp N0 &kp N1 &kp N2 &kp N3 &kp DOT &trans
                &trans &trans &trans &trans &trans &trans &trans &kp N0 &trans &trans
            >;
        };
        system {
            bindings = <
                &sys_reset &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_NEXT &none &none &none &kp UP &none &kp F12 &kp DEL
                &trans &none &none &none &none &none &none &kp LEFT &kp DOWN &kp RIGHT &kp F11 &kp ENTER
                &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp LC(LG(Q))
                &trans &trans &trans &trans &trans &trans &trans &kp C_PLAY_PAUSE &trans &trans
            >;
        };
    };
};
