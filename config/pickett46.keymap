#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
/ {
    keymap {
        compatible = "zmk,keymap";
        base {
            bindings = <
                &kp ESC   &kp Q &kp W &kp E &kp R &kp T  &kp Y &kp U &kp I     &kp O   &kp P   &kp BSPC
                &kp TAB   &kp A &kp S &kp D &kp F &kp G  &kp H &kp J &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B  &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp LCTRL &kp LALT &kp LGUI &kp SPACE &mo 1  &mo 1 &kp ENTER &kp BSPC &kp RALT &kp RCTRL
            >;
        };
        function {
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5  &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp DEL
                &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5  &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp LBKT &kp RBKT
                &trans &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp MINUS &kp EQUAL &kp BSLH &trans
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans &trans  &trans &trans &trans &trans &bt BT_CLR
            >;
        };
    };
};
