#include <physical_layouts.dtsi>

/ {
    pickett46_layout: pickett46_layout {
        compatible = "zmk,physical-layout";
        display-name = "Pickett46";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        // Switch centers from the PCB audit, in matrix transform order.
        keys //                    w   h    x    y       r    rx    ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400    0       0     0     0>
            , <&key_physical_attrs 100 100  500    0       0     0     0>
            , <&key_physical_attrs 100 100  921    0       0     0     0>
            , <&key_physical_attrs 100 100 1021    0       0     0     0>
            , <&key_physical_attrs 100 100 1121    0       0     0     0>
            , <&key_physical_attrs 100 100 1221    0       0     0     0>
            , <&key_physical_attrs 100 100 1321    0       0     0     0>
            , <&key_physical_attrs 100 100 1421    0       0     0     0>

            , <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100  100  100       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  100       0     0     0>
            , <&key_physical_attrs 100 100  500  100       0     0     0>
            , <&key_physical_attrs 100 100  921  100       0     0     0>
            , <&key_physical_attrs 100 100 1021  100       0     0     0>
            , <&key_physical_attrs 100 100 1121  100       0     0     0>
            , <&key_physical_attrs 100 100 1221  100       0     0     0>
            , <&key_physical_attrs 100 100 1321  100       0     0     0>
            , <&key_physical_attrs 100 100 1421  100       0     0     0>

            , <&key_physical_attrs 100 100    0  200       0     0     0>
            , <&key_physical_attrs 100 100  100  200       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  200       0     0     0>
            , <&key_physical_attrs 100 100  500  200       0     0     0>
            , <&key_physical_attrs 100 100  921  200       0     0     0>
            , <&key_physical_attrs 100 100 1021  200       0     0     0>
            , <&key_physical_attrs 100 100 1121  200       0     0     0>
            , <&key_physical_attrs 100 100 1221  200       0     0     0>
            , <&key_physical_attrs 100 100 1321  200       0     0     0>
            , <&key_physical_attrs 100 100 1421  200       0     0     0>

            , <&key_physical_attrs 100 100  233  300       0     0     0>
            , <&key_physical_attrs 100 100  333  300       0     0     0>
            , <&key_physical_attrs 100 100  448  342    3300   498   392>
            , <&key_physical_attrs 100 100  517  419    3300   567   469>
            , <&key_physical_attrs 100 100  572  335    3300   622   385>
            , <&key_physical_attrs 100 100  849  335 (-3300)   899   385>
            , <&key_physical_attrs 100 100  904  419 (-3300)   954   469>
            , <&key_physical_attrs 100 100  973  342 (-3300)  1023   392>
            , <&key_physical_attrs 100 100 1088  300       0     0     0>
            , <&key_physical_attrs 100 100 1188  300       0     0     0>;
    };
};
