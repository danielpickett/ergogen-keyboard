(version 1)
(rule "Two-layer fabrication clearance"
  (constraint clearance (min 0.20mm)))
(rule "Track width"
  (constraint track_width (min 0.20mm)))
(rule "Through-via geometry"
  (constraint via_diameter (min 0.60mm))
  (constraint hole_size (min 0.30mm))
  (constraint annular_width (min 0.15mm)))
(rule "Copper to routed board edge"
  (constraint edge_clearance (min 0.50mm)))
(rule "Hole separation"
  (constraint hole_to_hole (min 0.25mm)))
